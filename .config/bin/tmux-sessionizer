#!/usr/bin/env bash

# Allowed directories to fzf.
dirs=(
  ~/Documents/work
  ~/Documents/work/apps
  ~/Documents/personal
  ~/Documents/personal/apps
  ~/.config)

#
switch_to() {
  local name=$1
  local path=$2

  if [[ -z $TMUX ]]; then
    if ! tmux attach -t "$name" 2>/dev/null; then
      tmux new-session -s "$name" -c "$path"
    fi
    exit 0
  fi

  if ! tmux has-session -t="$name" 2>/dev/null; then
    tmux new-session -ds "$name" -c "$path"
  fi

  tmux switch-client -t "$name"
}

#
if [[ $1 == "-s" || $1 == "--sessions" ]]; then
  selected_name=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | fzf --query "$2")

  [[ -z $selected_name ]] && exit 0

  switch_to "$selected_name"
  exit 0
fi

#
selected_path=$(find "${dirs[@]}" -mindepth 1 -maxdepth 1 -type d | fzf --query "$1")

[[ -z $selected_path ]] && exit 0

selected_name=$(basename "$selected_path" | tr . _)

switch_to "$selected_name" "$selected_path"
